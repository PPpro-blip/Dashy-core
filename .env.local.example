# DashyCore v7 — Next.js frontend environment
# Copy to .env.local and fill in real values.
#
# SCOPING (Vercel):
#   - Production scope  → project `dashycore-v7`          (wtuyczwtuzwyhsckzhjd)
#   - Preview scope     → project `dashycore-v7-staging`  (gscvojambzzrgozpnhjf)
#
# Supabase (used for Supabase Auth session on the client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only Supabase key (route handlers / share fallbacks).
# NEVER prefix this with NEXT_PUBLIC_ — it must never reach the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Dashy Flow-State worker (real chat/model/RAG endpoint)
# URL of the deployed Cloudflare Worker
NEXT_PUBLIC_DASHY_FLOW_STATE_URL=https://dashy-flow-state.your-subdomain.workers.dev

# Dashy Digest worker (document/screenshot ingestion endpoint)
NEXT_PUBLIC_DASHY_DIGEST_URL=https://dashy-digest.your-subdomain.workers.dev

# CORS origin allowed by the worker (must match the worker's CORS_ORIGIN)
# Leave at http://localhost:3000 for local development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# EMAIL OTP DELIVERY (Resend) — DO NOT ADD ANY RESEND KEY HERE.
#
# Resend is configured ONLY inside each Supabase project:
#   Supabase Dashboard → Authentication → Settings → SMTP → Custom SMTP
#     Host: smtp.resend.com · Port: 465 (SSL) or 587 (TLS)
#     Username: resend
#     Password: <Resend API key re_...>   ← stored in Supabase only, never here
#     Sender: DashyCore <login@your-verified-resend-domain>
# and the "Magic Link / OTP" email template must include {{ .Token }} so the
# mail contains the 6-digit code (see AUTH-SETUP.md).
# The Resend API key must never appear in this file or in any NEXT_PUBLIC_*
# variable — the browser never talks to Resend directly.
# ---------------------------------------------------------------------------
